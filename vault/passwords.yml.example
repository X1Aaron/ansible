---
# Example Ansible Vault passwords file
# 
# Copy this file to passwords.yml and encrypt it:
#   cp vault/passwords.yml.example vault/passwords.yml
#   ansible-vault encrypt vault/passwords.yml
#
# Then edit it:
#   ansible-vault edit vault/passwords.yml
#
# Structure:
#   user_passwords:
#     username: "$6$rounds=656000$salt$hashed_password"
#
# Generate password hashes using:
#   python3 -c "import crypt; print(crypt.crypt('password', crypt.mksalt(crypt.METHOD_SHA512)))"
#   Or use: ./scripts/generate-password-hash.sh

user_passwords:
  # Example (replace with actual encrypted hashes):
  # john_doe: "$6$rounds=656000$salt$hashed_password_here"
  # jane_smith: "$6$rounds=656000$salt$hashed_password_here"

