---
# ============================================================================
# ⚠️  TEMPLATE FILE - DO NOT EDIT THIS FILE DIRECTLY! ⚠️
# ============================================================================
# 
# This is a TEMPLATE file in the repository.
# This file WILL be overwritten when you sync from GitHub!
# 
# To use this template:
#   1. Copy it: cp vars/hardening.local.yml.example vars/hardening.local.yml
#   2. Edit the COPY: nano vars/hardening.local.yml
#   3. The .local.yml file is git-ignored and will NOT be overwritten
# 
# Then uncomment and modify the examples below to configure server hardening.
# 
# ⚠️  IMPORTANT: Add your IP to hardening_ssh_allowed_sources before running firewall hardening!
# 
# ============================================================================
# END OF HEADER - YOU CAN DELETE EVERYTHING ABOVE THIS LINE AFTER COPYING
# ============================================================================

# General hardening options
hardening_update_packages: true          # [RECOMMENDED] Update all system packages
hardening_auto_updates: true             # [RECOMMENDED] Enable automatic security updates
hardening_configure_firewall: true       # [RECOMMENDED] Configure firewall (UFW/firewalld)
hardening_configure_fail2ban: true      # [RECOMMENDED] Install and configure fail2ban
hardening_harden_kernel: true            # [RECOMMENDED] Harden kernel network parameters
hardening_disable_services: true         # [RECOMMENDED] Disable unnecessary services
hardening_configure_ntp: true            # [RECOMMENDED] Configure time synchronization
hardening_set_file_permissions: true     # [RECOMMENDED] Set restrictive file permissions
hardening_configure_audit: true         # [RECOMMENDED] Configure audit logging (auditd)
# hardening_disable_ipv6: false           # [OPTIONAL] Disable IPv6 (set to true if not needed)

# SSH Hardening
hardening_ssh_harden: true               # [RECOMMENDED] Enable SSH hardening
hardening_ssh_permit_root_login: "no"    # [RECOMMENDED] Disable root login via SSH
hardening_ssh_password_auth: "no"        # [RECOMMENDED] Disable password authentication (use keys only)
hardening_ssh_pubkey_auth: "yes"         # [RECOMMENDED] Enable public key authentication
hardening_ssh_x11_forwarding: "no"       # [RECOMMENDED] Disable X11 forwarding
# hardening_ssh_max_auth_tries: 3          # [OPTIONAL] Maximum authentication attempts
# hardening_ssh_client_alive_interval: 300 # [OPTIONAL] Client alive interval (seconds)
# hardening_ssh_client_alive_count_max: 2  # [OPTIONAL] Client alive count max
# hardening_ssh_port: 22                   # [OPTIONAL] SSH port (change for security, e.g., 2222) - only uncomment if changing port
# hardening_ssh_config_backup: true        # [OPTIONAL] Backup SSH config before changes

# Trusted Source Whitelist (optional - leave undefined or empty to allow SSH from anywhere)
# Whitelisted IPs are trusted sources and allowed access to ALL ports (SSH, Proxmox, HTTP, HTTPS, etc.)
# Examples:
# hardening_ssh_allowed_sources:          # [OPTIONAL] Trusted source IPs/subnets/hostnames
#   - "192.168.1.0/24"        # Allow all ports from entire subnet (trusted network)
#   - "10.0.0.5"              # Allow all ports from specific IP (trusted host)
#   - "2001:db8::/32"         # Allow all ports from IPv6 subnet
#   - "office.example.com"    # Hostname (resolved to ALL IPs, updated every minute)
#   - "vpn.company.com"       # Hostname (resolved to ALL IPs, updated every minute)
# hardening_ssh_whitelist_auto_update: true  # [OPTIONAL] Auto-update hostname IPs (default: true)
# hardening_ssh_whitelist_update_interval: "1min"  # [OPTIONAL] Update interval (default: 1min, examples: "30s", "1min", "5min")
# Note: Hostnames are resolved to ALL IP addresses (not just the first one).
# If auto-update is enabled, hostnames are re-resolved at the specified interval to handle IP changes.
# SECURITY: Only whitelist IPs from trusted sources since they get access to ALL ports!
# If not specified or empty, only SSH will be allowed from anywhere (default UFW behavior)

# Firewall Configuration
# hardening_firewall_allowed_services:     # [OPTIONAL] Services to allow through firewall
#   - OpenSSH
#   # - "{{ hardening_ssh_port | default(22) }}/tcp"  # If you changed SSH port

# Fail2ban Configuration
# hardening_fail2ban_bantime: 3600         # [OPTIONAL] Ban time in seconds (1 hour)
# hardening_fail2ban_findtime: 600         # [OPTIONAL] Find time window in seconds (10 minutes)
# hardening_fail2ban_maxretry: 5           # [OPTIONAL] Maximum retries before ban
# hardening_fail2ban_email: "root@localhost"  # [OPTIONAL] Email for notifications

# Services to disable
# hardening_disabled_services:             # [OPTIONAL] Services to disable
#   - telnet
#   - rsh
#   - rlogin
#   - rexec
#   - nis
#   # Add more services you want to disable

# File permissions (path: mode)
# hardening_file_permissions:              # [OPTIONAL] File permissions (path: mode)
#   - { path: '/etc/passwd', mode: '0644' }
#   - { path: '/etc/shadow', mode: '0640' }
#   - { path: '/etc/group', mode: '0644' }
#   # Add more files as needed

