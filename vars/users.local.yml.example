---
# User Management Variables
# 
# This is YOUR file - edit this with your actual users!
# 
# This file is NOT tracked in git and will never be overwritten.
# 
# To get started, copy this file:
#   cp vars/users.local.yml.example vars/users.local.yml
#   nano vars/users.local.yml

# Users - The variables file is the source of truth
# Users in this list will be created or updated to match
# Users removed from this list will be deleted (if remove_orphaned_users is true)
users:
  - name: my_user
    groups: ['sudo']
    shell: /bin/bash
    comment: "My user"
    create_home: true
    # Your SSH public key (get it with: cat ~/.ssh/id_rsa.pub)
    ssh_public_key: "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC... your-key-here"
    # Password hash (optional - generate with: python3 -c "import crypt; print(crypt.crypt('password', crypt.mksalt(crypt.METHOD_SHA512)))")
    # password: "$6$rounds=656000$salt$hashed_password_here"
    password_lock: false
    # Sudo configuration (only applies if user is in 'sudo' group)
    sudo_passwordless: true  # Set to true for passwordless sudo (recommended with SSH keys)
    
    # Directory permissions (optional - grant access to specific directories)
    # NOTE: /opt/ansible access is AUTOMATIC for all users (no need to configure it here)
    # Use "USER" to automatically use the username, or specify a username/group directly
    # directories:
    #   - path: /opt/myproject
    #     owner: USER                   # Use "USER" to set owner to this user's name
    #     group: ansible                # Or set to a shared group name (ansible group exists automatically)
    #     mode: '0775'                  # Group writable
    #     recurse: false                # Apply recursively (optional, default: false)

# Options
remove_orphaned_users: false  # Set to true to delete users not in the 'users' list above
remove_home_on_delete: false  # Set to true to remove home directory when deleting users
force_remove: false  # Set to true to force removal even if user is logged in
system_users: []  # Additional system users to protect (root is always protected, UID < 1000 are always protected)
