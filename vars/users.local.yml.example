---
# Local User Configuration Override
# 
# This file is NOT tracked in git and will NOT be overwritten when syncing.
# Copy this file to users.local.yml and edit it with your server-specific users.
#
# Usage on your server:
#   cp vars/users.local.yml.example vars/users.local.yml
#   nano vars/users.local.yml
#
# This file will override/merge with vars/users.yml
# You can define users here and they will be used instead of the base file.

# Users to create (server-specific)
users_to_create:
  - name: my_user
    groups: ['sudo']
    shell: /bin/bash
    comment: "My server user"
    create_home: true
    generate_ssh_key: true
    ssh_key_type: rsa
    ssh_key_bits: 2048
    # Password will be automatically looked up from vault/passwords.yml if it exists
    # Or you can specify it explicitly:
    # password: "{{ user_passwords['my_user'] | default(omit) }}"
    password_lock: false

  # Add more users as needed:
  # - name: another_user
  #   groups: ['docker', 'www-data']
  #   shell: /bin/bash
  #   comment: "Another user"
  #   create_home: true

# Users to modify (if they already exist)
users_to_modify:
  # - name: existing_user
  #   groups: ['sudo', 'docker']
  #   append: true  # Add to existing groups
  #   shell: /bin/zsh
  #   comment: "Updated comment"

# Users to delete
users_to_delete:
  # - old_user1
  # - old_user2

# Options for delete action (optional)
# remove_home: false  # Set to true to remove home directory when deleting user
# force_remove: false  # Set to true to force removal even if user is logged in
