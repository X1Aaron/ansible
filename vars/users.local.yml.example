# ============================================================================
# ⚠️  TEMPLATE FILE - DO NOT EDIT THIS FILE DIRECTLY! ⚠️
# ============================================================================
# 
# This is a TEMPLATE file in the repository.
# This file WILL be overwritten when you sync from GitHub!
# 
# To use this template:
#   1. Copy it: cp vars/users.local.yml.example vars/users.local.yml
#   2. Edit the COPY: nano vars/users.local.yml
#   3. The .local.yml file is git-ignored and will NOT be overwritten
# 
# Then uncomment and modify the examples below to configure your users.
# 
# ============================================================================
# END OF HEADER - YOU CAN DELETE EVERYTHING ABOVE THIS LINE AFTER COPYING
# ============================================================================

# Users - The variables file is the source of truth
# Users in this list will be created or updated to match
# Users removed from this list will be deleted (if remove_orphaned_users is true)
users: []                                 # [REQUIRED] List of users to manage (can be empty)
# Example user - modify as needed:
- name: my_user                           # [REQUIRED] Username
  # groups: ['sudo']                      # [OPTIONAL] Groups to add user to (e.g., ['sudo', 'docker'])
  ssh_public_key: "ssh-rsa AAAAB3..."     # [RECOMMENDED] Your SSH public key
  # sudo_passwordless: true               # [OPTIONAL] Passwordless sudo (only if user is in 'sudo' group)
  # password: "$6$..."                    # [OPTIONAL] Password hash (for console login)
  # comment: "My user"                    # [OPTIONAL] User description

# Options
# remove_orphaned_users: false             # [OPTIONAL] Set to true to delete users not in the 'users' list above

