# To use this template:
#   1. Copy it: cp vars/secrets.local.yml.example vars/secrets.local.yml
#   2. Edit the COPY: nano vars/secrets.local.yml
#   3. Restrict permissions: chmod 600 vars/secrets.local.yml
#   4. The .local.yml file is git-ignored and will NOT be overwritten
# 
# ⚠️  SECURITY: The .local.yml file will contain sensitive information!
# ⚠️  Keep it secure and never commit it to git.
# 
# Store passwords as plain text or hash - your choice.
# If using plain text, make sure this file has restricted permissions (chmod 600).
# Generate password hash: python3 -c "import crypt; print(crypt.crypt('password', crypt.mksalt(crypt.METHOD_SHA512)))"
# 
# ============================================================================
# END OF HEADER - YOU CAN DELETE EVERYTHING ABOVE THIS LINE AFTER COPYING
# ============================================================================

# root_password: "your-secure-root-password-here"  # OPTIONAL: Root password in plain text (for emergency access)
# root_password_hash: "$6$rounds=656000$salt$hashed_password_here"  # OPTIONAL: Root password hash (more secure than plain text)
# database_password: "your-db-password"  # OPTIONAL: Database password or other secrets
# api_key: "your-api-key"  # OPTIONAL: API keys or other sensitive data

