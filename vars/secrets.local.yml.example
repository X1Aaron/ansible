# ============================================================================
# ⚠️  TEMPLATE FILE - DO NOT EDIT THIS FILE DIRECTLY! ⚠️
# ============================================================================
# 
# This is a TEMPLATE file in the repository.
# This file WILL be overwritten when you sync from GitHub!
# 
# To use this template:
#   1. Copy it: cp vars/secrets.local.yml.example vars/secrets.local.yml
#   2. Edit the COPY: nano vars/secrets.local.yml
#   3. Restrict permissions: chmod 600 vars/secrets.local.yml
#   4. The .local.yml file is git-ignored and will NOT be overwritten
# 
# ⚠️  SECURITY: The .local.yml file will contain sensitive information!
# ⚠️  Keep it secure and never commit it to git.
# 
# Then uncomment and modify the examples below to add your secrets.
# 
# ============================================================================
# END OF HEADER - YOU CAN DELETE EVERYTHING ABOVE THIS LINE AFTER COPYING
# ============================================================================

# Root password (for emergency access or initial setup)
# Store as plain text or hash - your choice
# If using plain text, make sure this file has restricted permissions (chmod 600)
# root_password: "your-secure-root-password-here"  # [OPTIONAL] Root password (plain text)

# Alternative: Store as password hash (more secure)
# Generate hash with: python3 -c "import crypt; print(crypt.crypt('password', crypt.mksalt(crypt.METHOD_SHA512)))"
# root_password_hash: "$6$rounds=656000$salt$hashed_password_here"  # [OPTIONAL] Root password (hashed)

# Other sensitive secrets can go here
# database_password: "your-db-password"  # [OPTIONAL] Database password
# api_key: "your-api-key"                # [OPTIONAL] API key

