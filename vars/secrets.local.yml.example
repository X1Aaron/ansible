---
# Secrets - NEVER commit this file to git!
# 
# This file contains sensitive information like passwords.
# 
# This file is NOT tracked in git and will never be overwritten.
# 
# To get started, copy this file:
#   cp vars/secrets.local.yml.example vars/secrets.local.yml
#   nano vars/secrets.local.yml
#   chmod 600 vars/secrets.local.yml  # Restrict permissions

# Root password (for emergency access or initial setup)
# Store as plain text or hash - your choice
# If using plain text, make sure this file has restricted permissions (chmod 600)
root_password: "your-secure-root-password-here"

# Alternative: Store as password hash (more secure)
# Generate hash with: python3 -c "import crypt; print(crypt.crypt('password', crypt.mksalt(crypt.METHOD_SHA512)))"
# root_password_hash: "$6$rounds=656000$salt$hashed_password_here"

# Other sensitive secrets can go here
# database_password: "your-db-password"
# api_key: "your-api-key"

