---
# ============================================================================
# ✅ YOUR CONFIG FILE - EDIT THIS FILE! ✅
# ============================================================================
# 
# This is YOUR configuration file.
# This file is OPTIONAL - Proxmox installation will use defaults if not configured.
# Uncomment and modify the examples below to configure Proxmox installation.
# 
# ============================================================================

# Proxmox release version
# Options: 'trixie' (Debian 13 - default), 'bookworm' (Debian 12), 'bullseye' (Debian 11)
# If this file doesn't exist or this is not set, defaults to 'trixie' (Debian 13)
# proxmox_release: trixie

# System update before installation
# proxmox_update_system: true

# Install Proxmox VE packages
# proxmox_install_packages: true

# Configure Proxmox after installation
# proxmox_configure: true

# Hostname for the Proxmox server
# proxmox_hostname: pve1.example.com

# Reboot after installation (if required)
# proxmox_reboot_after_install: true

# Network configuration (optional)
# Uncomment and configure if you need to set up network interfaces
# proxmox_network_config:
#   - interface: enp0s3
#     method: static
#     address: 192.168.1.100
#     netmask: 255.255.255.0
#     gateway: 192.168.1.1
#     dns_nameservers:
#       - 8.8.8.8
#       - 8.8.4.4

