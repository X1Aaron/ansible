---
# ============================================================================
# ⚠️  TEMPLATE FILE - DO NOT EDIT THIS FILE DIRECTLY! ⚠️
# ============================================================================
# 
# This is a TEMPLATE file in the repository.
# This file WILL be overwritten when you sync from GitHub!
# 
# To use this template:
#   1. Copy it: cp vars/proxmox.local.yml.example vars/proxmox.local.yml
#   2. Edit the COPY: nano vars/proxmox.local.yml
#   3. The .local.yml file is git-ignored and will NOT be overwritten
# 
# This file is OPTIONAL - Proxmox installation will use defaults if not configured.
# Then uncomment and modify the examples below to configure Proxmox installation.
# 
# ============================================================================
# END OF HEADER - YOU CAN DELETE EVERYTHING ABOVE THIS LINE AFTER COPYING
# ============================================================================

# Proxmox release version
# Options: 'trixie' (Debian 13 - default), 'bookworm' (Debian 12), 'bullseye' (Debian 11)
# If this file doesn't exist or this is not set, defaults to 'trixie' (Debian 13)
proxmox_release: trixie  # OPTIONAL: Proxmox release version (default: 'trixie' for Debian 13)

# System update before installation
proxmox_update_system: true  # RECOMMENDED: Update system packages before installation (default: true)

# Install Proxmox VE packages
proxmox_install_packages: true  # REQUIRED: Install Proxmox VE packages (default: true, set to false to skip installation)

# Configure Proxmox after installation
proxmox_configure: true  # RECOMMENDED: Configure Proxmox after installation (default: true)

# Hostname for the Proxmox server
# proxmox_hostname: pve1.example.com  # OPTIONAL: Set specific hostname (only uncomment if you want to set a custom hostname)

# Reboot after installation (if required)
proxmox_reboot_after_install: true  # RECOMMENDED: Reboot after installation if required (default: true)

# Network configuration
# proxmox_network_config:  # OPTIONAL: Network interface configuration (only uncomment if you need to configure network)
#   - interface: enp0s3
#     method: static
#     address: 192.168.1.100
#     netmask: 255.255.255.0
#     gateway: 192.168.1.1
#     dns_nameservers:
#       - 8.8.8.8
#       - 8.8.4.4

